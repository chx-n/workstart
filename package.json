{
  "name": "workstart",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:packaging": "cargo test --manifest-path src-tauri/Cargo.toml --test packaging",
    "icons:generate": "bash scripts/generate-icons.sh",
    "build:debug": "tauri build --debug --no-bundle",
    "package:fedora:unsigned": "tauri build --target x86_64-unknown-linux-gnu --bundles rpm --no-sign",
    "package:windows:unsigned": "tauri build --target x86_64-pc-windows-msvc --bundles nsis --no-sign",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/svelte": "^5.0.0",
    "@types/node": "^24.0.0",
    "jsdom": "^27.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  },
  "packageManager": "pnpm@12.5.1"
}
